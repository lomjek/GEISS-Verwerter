zahl x <- 12563

funktion wurzel(zahl x, nzahl wiederholungen) -> zahl resultat
{
  zahl jetzt <- x

  wiederhole wiederholungen mal {
    jetzt <- 0.5 * (jetzt + x / jetzt)
  }

  resultat <- jetzt
  beende funktion
}

schreibe(als_text(x))
zahl y <- wurzel(x, 10)
schreibe(als_text(y))

beende programm
