gzahl guess <- 0

schreibe("Ich denke mir eine Zahl zwischen 1 und 100")
ganze zahl zufällige_zahl <- zufällige_zahl(1, 100)

solange guess nicht = zufällige_zahl {
	// Frage den Benutzter nach einer Zahl...
	guess <- eingabe("Errate meine Zahl:")

	falls guess = zufällige_zahl {
		schreibe("Du hast es geschafft!")
	}

	sonst falls guess < zufällige_zahl {
		schreibe("Deine Zahl ist zu klein!")
	}

	sonst {
		schreibe("Deine Zahl ist zu gross!")
	}
}
