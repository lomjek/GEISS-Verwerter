{
	"authors": [
		"lomjek"
	],
	"copyright": "Copyright © 2026, lomjek",
	"description": "Ein Intepreter für meine Programmiersprache GEISS",
	"license": "LGPL-3.0-or-later",
	"name": "interpreter",
	"targetName": "geiss.dc",
	"targetType": "executable",
	"configurations": [
		{
			"name": "default",
			"mainSourceFile": "kern/geiss.d",
			"sourcePaths": [
				"kern"
			],
			"importPaths": [
				"kern"
			]
		},
		{
			"name": "full-dynamic",
			"mainSourceFile": "kern/geiss.d",
			"sourcePaths": [
				"kern"
			],
			"importPaths": [
				"kern"
			],
			"dflags": [
				"-link-defaultlib-shared"
			]
		},
		{
			"name": "static",
			"mainSourceFile": "kern/geiss.d",
			"sourcePaths": [
				"kern"
			],
			"importPaths": [
				"kern"
			],
			"dflags": [
				"-static"
			]
		},
		{
			"name": "unittest",
			"mainSourceFile": "kern/geiss.d",
      "targetName": "interpreter-test-default",
			"sourcePaths": [
				"kern",
				"tests"
			],
			"importPaths": [
				"kern",
				"tests"
			]
		}
	],
	"buildTypes": {
		"release": {
			"dflags": [
				"-Os",
				"-flto=full"
			],
			"lflags": [
				"--gc-sections"
			]
		},
		"debug": {
			"dflags": [
				"-O0",
				"-gc",
				"--d-debug"
			]
		}
	}
}
